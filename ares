    """
    width = 110
    show_network = data["multiple_networks"]
    pending_services = []

    print()
    print(BOLD + "SERVICES" + RESET)
    print("─" * width)

    if show_network:
        print(f"{'ID':<4}  {'Network':<18} {'IP':<16} {'Hostname':<25} {'Port':<6} {'Proto':<6} {'Service':<12} {'Version':<20} {'Status'}")
    else:
        print(f"{'ID':<4}  {'IP':<16} {'Hostname':<40} {'Port':<6} {'Proto':<6} {'Service':<12} {'Version':<20} {'Status'}")

    print("─" * width)

    for s in data["services"]:
        status = "accepted" if s["accepted"] else "pending"

        if show_network:
            row = (
                f"{s['id']:<4}  "
                f"{s['network']:<18} "
                f"{s['ip']:<16} "
                f"{s['hostname']:<25} "
                f"{s['port']:<6} "
                f"{s['protocol']:<6} "
                f"{s['service']:<12} "
                f"{s['version']:<20} "
                f"{status}"
            )
        else:
            row = (
                f"{s['id']:<4}  "
                f"{s['ip']:<16} "
                f"{s['hostname']:<40} "
                f"{s['port']:<6} "
                f"{s['protocol']:<6} "
                f"{s['service']:<12} "
                f"{s['version']:<20} "
                f"{status}"
            )

        if not s["accepted"]:
            print(RED + BOLD + row + RESET)
            pending_services.append(s)
        else:
            print(GREEN + row + RESET)

    print("─" * width)
    print(
        f"Total: {data['total']} services  |  "
        f"{GREEN}Accepted: {data['accepted']}{RESET}  |  "
        f"{RED}Pending: {data['pending']}{RESET}"
    )

    if pending_services:
        print()
        print(BOLD + YELLOW + "ACTION REQUIRED" + RESET)
        print("─" * width)
        for s in pending_services:
            print(f"  ares --accept-device {s['ip']}")

    print()


# ─── SCAN RUNNER ──────────────────────────────────────────────────────────────

def run_scan(network: str, interface: str, mode: str, loki: str | None,
             scan_devices: bool, scan_services: bool):
    """
    Runs a scan for a single network.
    Handles device scan, optional service scan, and deviation check.
    """
    if scan_devices:
        log_and_push(loki, "scan_start", network=network)
        print(f"[INFO] Scanning network {network}...")

        xml_devices = run_nmap(network, interface, mode)
        devices = parse_nmap_xml(xml_devices)
        print_devices_list(devices)

        db_save_devices(devices, network)

        for d in devices:
            log_and_push(loki, "device_seen",
                         ip=d["ip"], mac=d["mac"] or "-",
                         hostname=d["hostname"] or "-",
                         network=network)

    if scan_services:
        print(f"[INFO] Starting service scan for {network} (this may take a while)...")
        xml_services = run_nmap_services(network, interface)
        services = parse_nmap_services_xml(xml_services)
        print_services_list(services)

        version_changes = db_save_services(services)

        for vc in version_changes:
            log_and_push(loki, "version_change", level="warn",
                         port=vc["port"],
                         service=vc["service"],
                         old_version=vc["old_version"],
                         new_version=vc["new_version"],
                         network=network)

    if scan_devices:
        deviations = db_check_deviations(network)

        for dev in deviations:
            if dev["event_type"] == "new_device":
                log_and_push(loki, "new_device", level="warn",
                             ip=dev["ip"], mac=dev["mac"],
                             hostname=dev["hostname"], network=network)

            elif dev["event_type"] == "new_port":
                log_and_push(loki, "new_port", level="warn",
                             ip=dev["ip"], port=dev["port"],
                             service=dev["service"], version=dev["version"],
                             network=network)

        log_and_push(loki, "scan_complete",
                     total_devices=len(devices) if scan_devices else 0,
                     unknown_count=len(deviations),
                     network=network)


# ─── MAIN ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description="ARES network and device scanner")

    # ── Network / config arguments
    parser.add_argument("--network",   required=False,
                        help="Target network e.g. 192.168.2.0/24 (overrides config)")
    parser.add_argument("--interface", required=False, default="",
                        help="Network interface e.g. eth1 (optional)")
    parser.add_argument("--mode",      required=False, default="arp",
                        choices=["arp", "ip"],
                        help="Scan mode: arp (L2, MAC visible) or ip (L3, no MAC)")
    parser.add_argument("--loki-url",  default=None,
                        help="Loki Push URL e.g. http://10.8.0.1:3100 (optional)")

    # ── Scan arguments
    parser.add_argument("--scan-devices", action="store_true",
                        help="Run device discovery scan (fast)")
    parser.add_argument("--scan-services", action="store_true",
                        help="Run service and version scan (slow)")
    parser.add_argument("--scan-all", action="store_true",
                        help="Run device scan + service scan")

    # ── Baseline arguments
    parser.add_argument("--accept-baseline", action="store_true",
                        help="Accept and freeze current state as baseline")
    parser.add_argument("--reset-baseline", action="store_true",
                        help="Reset baseline – all devices set back to pending")
    parser.add_argument("--accept-device", metavar="IP",
                        help="Accept a single device by IP address")

    # ── Admin arguments
    parser.add_argument("--status", action="store_true",
                        help="Alias for --status-all (backwards compatible)")
    parser.add_argument("--status-devices", action="store_true",
                        help="Show device status table")
    parser.add_argument("--status-services", action="store_true",
                        help="Show services status table")
    parser.add_argument("--status-all", action="store_true",
                        help="Show devices and services status tables")

    args = parser.parse_args()

    # ── Load config
    config   = load_config()
    networks = get_networks(config)

    # ── Loki URL: CLI overrides config
    loki = args.loki_url or config.get("global", "loki_url", fallback=None)

    # ── DB init – always runs first
    db_init()

    # ── Admin operations – no scan needed
    if args.status or args.status_all:
        width = 110
        print()
        print(BOLD + "ARES Network Scanner – Status" + RESET)
        print("═" * width)
        print_status(db_get_status(args.network))
        print_services_status(db_get_services_status(args.network))
        print("═" * width)
        print()
        sys.exit(0)

    if args.status_devices:
        width = 110
        print()
        print(BOLD + "ARES Network Scanner – Status" + RESET)
        print("═" * width)
        print_status(db_get_status(args.network))
        print("═" * width)
        print()
        sys.exit(0)

    if args.status_services:
        width = 110
        print()
        print(BOLD + "ARES Network Scanner – Status" + RESET)
        print("═" * width)
        print_services_status(db_get_services_status(args.network))
        print("═" * width)
        print()
        sys.exit(0)

    # ── Baseline operations – no scan needed
    if args.accept_baseline:
        db_accept_baseline()
        sys.exit(0)

    if args.reset_baseline:
        db_reset_baseline()
        sys.exit(0)

    if args.accept_device:
        db_accept_device(args.accept_device)
        sys.exit(0)

    # ── Determine scan flags
    scan_devices  = args.scan_devices or args.scan_all
    scan_services = args.scan_services or args.scan_all

    if not scan_devices and not scan_services:
        parser.error("Specify a scan mode: --scan-devices, --scan-services, or --scan-all")

    # ── Scan: CLI network overrides config networks
    if args.network:
        # Single network from CLI
        run_scan(
            network=args.network,
            interface=args.interface,
            mode=args.mode,
            loki=loki,
            scan_devices=scan_devices,
            scan_services=scan_services
        )

    elif networks:
        # Multiple networks from config
        for net in networks:
            run_scan(
                network=net["network"],
                interface=net["interface"],
                mode=net["mode"],
                loki=loki,
                scan_devices=scan_devices,
                scan_services=scan_services
            )

    else:
        parser.error("No network specified. Use --network or define networks in /etc/ares/ares.conf")


if __name__ == "__main__":
    main()
