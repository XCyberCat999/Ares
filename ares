def log_event(event: str, level: str = "info", **kwargs):
    """Writes a structured JSON event to the log."""
    entry = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "level": level,
        "event": event,
        "host": HOSTNAME,
        "job": "ares-scanner",
        **kwargs
    }
    msg = json.dumps(entry)
    if level == "warn":
        logging.warning(msg)
    elif level == "error":
        logging.error(msg)
    else:
        logging.info(msg)
    return msg


# ─── LOKI PUSH ────────────────────────────────────────────────────────────────

def push_to_loki(loki_url: str, json_line: str, level: str = "info"):
    """Pushes a log entry directly to the Loki Push API."""
    payload = {
        "streams": [{
            "stream": {
                "job": "ares-scanner",
                "host": HOSTNAME,
                "level": level
            },
            "values": [[
                str(int(time.time() * 1e9)),   # nanosecond timestamp
                json_line
            ]]
        }]
    }
    try:
        resp = requests.post(
            f"{loki_url}/loki/api/v1/push",
            json=payload,
            headers={"Content-Type": "application/json"},
            timeout=5
        )
        if resp.status_code != 204:
            print(f"[WARN] Loki response: {resp.status_code} {resp.text}")
    except requests.exceptions.RequestException as e:
        print(f"[ERROR] Loki push failed: {e}")


def log_and_push(loki_url: str | None, event: str, level: str = "info", **kwargs):
    """Combines log_event() + push_to_loki() in a single call."""
    json_line = log_event(event, level, **kwargs)
    if loki_url:
        push_to_loki(loki_url, json_line, level)


# ─── NMAP SCAN ────────────────────────────────────────────────────────────────

def run_nmap(network: str, interface: str = "", mode: str = "arp") -> str:
    """
    Runs a device discovery scan.
    mode='arp'  → ARP scan, MAC addresses visible (L2 only)
    mode='ip'   → ping scan, no MAC addresses (L3 / remote networks)
    """
    if mode == "arp":
        cmd = ["nmap", "-sn", "-PR", network, "-oX", "-"]
        if interface:
            cmd += ["-e", interface]
    else:
        cmd = ["nmap", "-sn", network, "-oX", "-"]

    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if proc.returncode != 0:
        raise RuntimeError(f"Nmap-Error: {proc.stderr.strip()}")
    return proc.stdout


def run_nmap_services(network: str, interface: str = "") -> str:
    """Runs a full service and version scan."""
    cmd = ["nmap", "-sV", "--version-intensity", "9", network, "-oX", "-"]
    if interface:
        cmd += ["-e", interface]

    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if proc.returncode != 0:
        raise RuntimeError(f"Nmap-Error: {proc.stderr.strip()}")
    return proc.stdout


# ─── PARSE XML ────────────────────────────────────────────────────────────────

def parse_nmap_xml(xml_text: str):
    devices = []
    root = ET.fromstring(xml_text)
    for host in root.findall("host"):
        ip = ""
        mac = ""
        hostname = ""
        for addr in host.findall("address"):
            if addr.get("addrtype") in ("ipv4", "ipv6"):
                ip = addr.get("addr", "")
            elif addr.get("addrtype") == "mac":
                mac = addr.get("addr", "").upper()
        hn = host.find("hostnames/hostname")
        if hn is not None:
            hostname = hn.get("name", "")
        devices.append({"hostname": hostname, "ip": ip, "mac": mac})
    return devices


def parse_nmap_services_xml(xml_text: str):
    services = []
    root = ET.fromstring(xml_text)
    for host in root.findall("host"):
        hostname = ""
        hn = host.find("hostnames/hostname")
        if hn is not None:
            hostname = hn.get("name", "")
        ports = []
        for port in host.findall("ports/port"):
            portid = port.get("portid")
            state = port.find("state").get("state")
            svc = port.find("service")
            service_name = svc.get("name") if svc is not None else ""
            service_version = svc.get("version") if svc is not None else ""
            ports.append({"port": portid, "state": state,
                          "service": service_name, "version": service_version})
        services.append({"hostname": hostname or "-", "ports": ports})
    return services


