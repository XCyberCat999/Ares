# ─── DATABASE ─────────────────────────────────────────────────────────────────

def db_init():
    """
    Creates the SQLite database and all tables if they don't exist yet.
    Runs migration to add network column if it doesn't exist.
    Safe to call on every start – existing data is never overwritten.
    """
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    cur.executescript("""
        CREATE TABLE IF NOT EXISTS devices (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            ip          TEXT NOT NULL,
            mac         TEXT,
            hostname    TEXT,
            first_seen  TEXT NOT NULL,
            last_seen   TEXT NOT NULL,
            status      TEXT NOT NULL DEFAULT 'pending',
            network     TEXT NOT NULL DEFAULT ''
        );

        CREATE TABLE IF NOT EXISTS services (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            device_id   INTEGER NOT NULL,
            port        TEXT NOT NULL,
            protocol    TEXT NOT NULL DEFAULT 'tcp',
            service     TEXT,
            version     TEXT,
            first_seen  TEXT NOT NULL,
            last_seen   TEXT NOT NULL,
            FOREIGN KEY (device_id) REFERENCES devices(id)
        );

        CREATE TABLE IF NOT EXISTS baseline (
            id           INTEGER PRIMARY KEY AUTOINCREMENT,
            device_id    INTEGER,
            service_id   INTEGER,
            accepted_at  TEXT NOT NULL,
            FOREIGN KEY (device_id) REFERENCES devices(id),
            FOREIGN KEY (service_id) REFERENCES services(id)
        );

        CREATE TABLE IF NOT EXISTS events (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            device_id   INTEGER,
            service_id  INTEGER,
            event_type  TEXT NOT NULL,
            old_value   TEXT,
            new_value   TEXT,
            timestamp   TEXT NOT NULL,
            FOREIGN KEY (device_id) REFERENCES devices(id),
            FOREIGN KEY (service_id) REFERENCES services(id)
        );
    """)

    # Migration – add network column to existing databases
    try:
        cur.execute("ALTER TABLE devices ADD COLUMN network TEXT NOT NULL DEFAULT ''")
        conn.commit()
    except sqlite3.OperationalError:
        pass  # Column already exists – no action needed

    conn.commit()
    conn.close()


def db_save_devices(devices: list, network: str) -> list:
    """
    Saves scanned devices to the database.
    - New device   → INSERT, status='pending'
    - Known device → UPDATE last_seen only
    Returns a list of newly discovered devices.
    """
    now = datetime.now(timezone.utc).isoformat()
    new_devices = []

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    for d in devices:
        ip       = d["ip"]
        mac      = d["mac"] or None
        hostname = d["hostname"] or None

        # Check if device already exists in DB (identified by MAC + network, fallback IP + network)
        if mac:
            cur.execute("SELECT id, status FROM devices WHERE mac = ? AND network = ?", (mac, network))
        else:
            cur.execute("SELECT id, status FROM devices WHERE ip = ? AND network = ?", (ip, network))

        row = cur.fetchone()

        if row is None:
            # New device – INSERT
            cur.execute("""
                INSERT INTO devices (ip, mac, hostname, first_seen, last_seen, status, network)
                VALUES (?, ?, ?, ?, ?, 'pending', ?)
            """, (ip, mac, hostname, now, now, network))
            new_devices.append(d)
        else:
            # Known device – UPDATE last_seen
            cur.execute("""
                UPDATE devices SET last_seen = ?, ip = ?, hostname = ?
                WHERE id = ?
            """, (now, ip, hostname, row[0]))

    conn.commit()
    conn.close()

    return new_devices


def db_save_services(services: list) -> list:
    """
    Saves scanned services to the database.
    - New service    → INSERT
    - Known service  → UPDATE last_seen
    - Version change → UPDATE + record change event
    Returns a list of version change events.
    """
    now = datetime.now(timezone.utc).isoformat()
    version_changes = []

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    for s in services:
        # Find device in DB by hostname or skip if not found
        cur.execute("SELECT id FROM devices WHERE hostname = ?", (s["hostname"],))
        device_row = cur.fetchone()

        if device_row is None:
            # Device not in DB yet – skip
            continue

        device_id = device_row[0]

        for p in s["ports"]:
            port    = p["port"]
            service = p["service"] or None
            version = p["version"] or None

            # Check if service already exists for this device + port
            cur.execute("""
                SELECT id, version FROM services
                WHERE device_id = ? AND port = ?
            """, (device_id, port))

            row = cur.fetchone()

            if row is None:
                # New service – INSERT
                cur.execute("""
                    INSERT INTO services
                        (device_id, port, protocol, service, version, first_seen, last_seen)
                    VALUES (?, ?, 'tcp', ?, ?, ?, ?)
                """, (device_id, port, service, version, now, now))

            else:
                service_id  = row[0]
                old_version = row[1]

                # Version changed?
                if old_version != version and version is not None:
                    version_changes.append({
                        "device_id":   device_id,
                        "service_id":  service_id,
                        "port":        port,
                        "service":     service,
                        "old_version": old_version,
                        "new_version": version,
                    })

                # UPDATE last_seen and version
                cur.execute("""
                    UPDATE services
                    SET last_seen = ?, version = ?, service = ?
                    WHERE id = ?
                """, (now, version, service, service_id))

    conn.commit()
    conn.close()

    return version_changes


def db_check_deviations(network: str) -> list:
    """
    Checks for deviations from the accepted baseline.
    Only checks devices and services within the given network.
    Returns a list of deviation events.

    Deviation types:
    - new_device → device exists in DB but not in baseline
    - new_port   → service exists in DB but not in baseline
    """
    deviations = []

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    # Check for devices not in baseline – only current network
    cur.execute("""
        SELECT d.id, d.ip, d.mac, d.hostname
        FROM devices d
        WHERE d.status = 'pending'
        AND d.network = ?
        AND d.id NOT IN (
            SELECT device_id FROM baseline
            WHERE device_id IS NOT NULL
        )
    """, (network,))

    for row in cur.fetchall():
        deviations.append({
            "event_type": "new_device",
            "device_id":  row[0],
            "ip":         row[1],
            "mac":        row[2] or "-",
            "hostname":   row[3] or "-",
        })

    # Check for services not in baseline – only current network
    cur.execute("""
        SELECT s.id, s.device_id, s.port, s.service, s.version,
               d.ip, d.hostname
        FROM services s
        JOIN devices d ON s.device_id = d.id
        WHERE s.id NOT IN (
            SELECT service_id FROM baseline
            WHERE service_id IS NOT NULL
        )
        AND d.status = 'accepted'
        AND d.network = ?
    """, (network,))

    for row in cur.fetchall():
        deviations.append({
            "event_type": "new_port",
            "service_id": row[0],
            "device_id":  row[1],
            "port":       row[2],
            "service":    row[3] or "-",
            "version":    row[4] or "-",
            "ip":         row[5],
            "hostname":   row[6] or "-",
        })

    conn.close()

    return deviations


# ─── BASELINE ─────────────────────────────────────────────────────────────────

def db_accept_baseline():
    """
    Freezes the current state as baseline.
    All devices and services with status='pending' → status='accepted'.
    Writes all accepted entries into the baseline table.
    """
    now = datetime.now(timezone.utc).isoformat()

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    cur.execute("""
        UPDATE devices SET status = 'accepted'
        WHERE status = 'pending'
    """)

    cur.execute("""
        INSERT INTO baseline (device_id, service_id, accepted_at)
        SELECT d.id, NULL, ?
        FROM devices d
        WHERE d.status = 'accepted'
        AND d.id NOT IN (
            SELECT device_id FROM baseline WHERE device_id IS NOT NULL
        )
    """, (now,))

    cur.execute("""
        INSERT INTO baseline (device_id, service_id, accepted_at)
        SELECT s.device_id, s.id, ?
        FROM services s
        JOIN devices d ON s.device_id = d.id
        WHERE d.status = 'accepted'
        AND s.id NOT IN (
            SELECT service_id FROM baseline WHERE service_id IS NOT NULL
        )
    """, (now,))

    conn.commit()
    conn.close()

    print("[INFO] Baseline accepted and frozen.")


def db_reset_baseline():
    """
    Resets the entire baseline.
    All devices go back to status='pending'.
    Baseline table is cleared.
    """
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    cur.executescript("""
        UPDATE devices SET status = 'pending';
        DELETE FROM baseline;
    """)

    conn.commit()
    conn.close()

    print("[INFO] Baseline reset. All devices set to pending.")


def db_accept_device(ip: str):
    """
    Accepts a single device by IP address.
    Sets status='accepted' and writes it into the baseline table.
    Also accepts all services belonging to this device.
    """
    now = datetime.now(timezone.utc).isoformat()

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    cur.execute("SELECT id FROM devices WHERE ip = ?", (ip,))
    row = cur.fetchone()

    if row is None:
        print(f"[WARN] Device {ip} not found in database.")
        conn.close()
        return

    device_id = row[0]

    cur.execute("UPDATE devices SET status = 'accepted' WHERE id = ?", (device_id,))

    cur.execute("""
        INSERT INTO baseline (device_id, service_id, accepted_at)
        SELECT ?, NULL, ?
        WHERE NOT EXISTS (
            SELECT 1 FROM baseline WHERE device_id = ?
        )
    """, (device_id, now, device_id))

    cur.execute("""
        INSERT INTO baseline (device_id, service_id, accepted_at)
        SELECT s.device_id, s.id, ?
        FROM services s
        WHERE s.device_id = ?
        AND s.id NOT IN (
            SELECT service_id FROM baseline WHERE service_id IS NOT NULL
        )
    """, (now, device_id))

    conn.commit()
    conn.close()

    print(f"[INFO] Device {ip} accepted and added to baseline.")


# ─── STATUS ───────────────────────────────────────────────────────────────────

def db_get_status(network: str = None) -> dict:
    """
    Fetches current device status overview from the database.
    If network is given, filters by network.
    Returns a dict with devices and summary counters.
    """
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    if network:
        cur.execute("""
            SELECT d.id, d.ip, d.mac, d.hostname, d.status, d.last_seen,
                   b.accepted_at, d.network
            FROM devices d
            LEFT JOIN baseline b ON d.id = b.device_id AND b.service_id IS NULL
            WHERE d.network = ?
            ORDER BY d.ip ASC
        """, (network,))
    else:
        cur.execute("""
            SELECT d.id, d.ip, d.mac, d.hostname, d.status, d.last_seen,
                   b.accepted_at, d.network
            FROM devices d
            LEFT JOIN baseline b ON d.id = b.device_id AND b.service_id IS NULL
            ORDER BY d.network ASC, d.ip ASC
        """)

    rows = cur.fetchall()
    conn.close()

    devices = []
    for row in rows:
        devices.append({
            "id":          row[0],
            "ip":          row[1],
            "mac":         row[2] or "-",
            "hostname":    row[3] or "-",
            "status":      row[4],
            "last_seen":   row[5],
            "accepted_at": row[6] or "-",
            "network":     row[7] or "-",
        })

    networks = set(d["network"] for d in devices)

    return {
        "devices":           devices,
        "total":             len(devices),
        "accepted":          sum(1 for d in devices if d["status"] == "accepted"),
        "pending":           sum(1 for d in devices if d["status"] == "pending"),
        "multiple_networks": len(networks) > 1,
    }


def db_get_services_status(network: str = None) -> dict:
    """
    Fetches all services with their device info from the database.
    If network is given, filters by network.
    Returns a dict with services and summary counters.
    """
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    if network:
        cur.execute("""
            SELECT s.id, s.port, s.protocol, s.service, s.version, s.last_seen,
                   d.ip, d.hostname, b.accepted_at, d.network
            FROM services s
            JOIN devices d ON s.device_id = d.id
            LEFT JOIN baseline b ON s.id = b.service_id AND b.service_id IS NOT NULL
            WHERE d.network = ?
            ORDER BY d.ip ASC, CAST(s.port AS INTEGER) ASC
        """, (network,))
    else:
        cur.execute("""
            SELECT s.id, s.port, s.protocol, s.service, s.version, s.last_seen,
                   d.ip, d.hostname, b.accepted_at, d.network
            FROM services s
            JOIN devices d ON s.device_id = d.id
            LEFT JOIN baseline b ON s.id = b.service_id AND b.service_id IS NOT NULL
            ORDER BY d.network ASC, d.ip ASC, CAST(s.port AS INTEGER) ASC
        """)

    rows = cur.fetchall()
    conn.close()

    services = []
    for row in rows:
        services.append({
            "id":        row[0],
            "port":      row[1],
            "protocol":  row[2],
            "service":   row[3] or "-",
            "version":   row[4] or "-",
            "last_seen": row[5],
            "ip":        row[6],
            "hostname":  row[7] or "-",
            "accepted":  row[8] is not None,
            "network":   row[9] or "-",
        })

    networks = set(s["network"] for s in services)

    return {
        "services":          services,
        "total":             len(services),
        "accepted":          sum(1 for s in services if s["accepted"]),
        "pending":           sum(1 for s in services if not s["accepted"]),
        "multiple_networks": len(networks) > 1,
    }


def print_status(data: dict):
    """
    Prints a formatted device status table to the console.
    PENDING devices are highlighted in red.
    Network column shown only when multiple networks are present.
    Includes action hints if pending devices exist.
    """
    width = 110
    show_network = data["multiple_networks"]
    pending_devices = []

    print()
    print(BOLD + "DEVICES" + RESET)
    print("─" * width)

    if show_network:
        print(f"{'ID':<4}  {'Network':<18} {'IP':<16} {'MAC':<18} {'Hostname':<30} {'Status':<10} {'Last Seen'}")
    else:
        print(f"{'ID':<4}  {'IP':<16} {'MAC':<18} {'Hostname':<40} {'Status':<10} {'Last Seen'}")

    print("─" * width)

    for d in data["devices"]:
        last_seen = d["last_seen"][:16].replace("T", " ") if d["last_seen"] else "-"

        if show_network:
            row = (
                f"{d['id']:<4}  "
                f"{d['network']:<18} "
                f"{d['ip']:<16} "
                f"{d['mac']:<18} "
                f"{d['hostname']:<30} "
                f"{d['status']:<10} "
                f"{last_seen}"
            )
        else:
            row = (
                f"{d['id']:<4}  "
                f"{d['ip']:<16} "
                f"{d['mac']:<18} "
                f"{d['hostname']:<40} "
                f"{d['status']:<10} "
                f"{last_seen}"
            )

        if d["status"] == "pending":
            print(RED + BOLD + row + RESET)
            pending_devices.append(d)
        else:
            print(GREEN + row + RESET)

    print("─" * width)
    print(
        f"Total: {data['total']} devices  |  "
        f"{GREEN}Accepted: {data['accepted']}{RESET}  |  "
        f"{RED}Pending: {data['pending']}{RESET}"
    )

    if pending_devices:
        print()
        print(BOLD + YELLOW + "ACTION REQUIRED" + RESET)
        print("─" * width)
        for d in pending_devices:
            print(f"  ares --accept-device {d['ip']}")

    print()


