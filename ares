# ─── CONFIG ───────────────────────────────────────────────────────────────────

def load_config() -> configparser.ConfigParser:
    """
    Loads configuration from /etc/ares/ares.conf.
    Returns a ConfigParser object.
    If the file does not exist, returns an empty config.
    """
    config = configparser.ConfigParser()
    if os.path.isfile(CONF_PATH):
        config.read(CONF_PATH)
    return config


def get_networks(config: configparser.ConfigParser) -> list:
    """
    Extracts all [network:name] sections from the config.
    Returns a list of network dicts.

    Each dict contains:
      name      → section name (e.g. 'lan')
      network   → CIDR notation (e.g. '192.168.2.0/24')
      interface → network interface (e.g. 'eth1'), optional
      mode      → 'arp' (L2, MAC visible) or 'ip' (L3, no MAC)
    """
    networks = []
    for section in config.sections():
        if section.startswith("network:"):
            name = section.split(":", 1)[1]
            networks.append({
                "name":      name,
                "network":   config.get(section, "network", fallback=""),
                "interface": config.get(section, "interface", fallback=""),
                "mode":      config.get(section, "mode", fallback="arp"),
            })
    return networks


